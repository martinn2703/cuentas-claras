{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true, // -> hay que definir todos los tipos de datos
    "noUncheckedIndexedAccess": true, // -> hay que definir los tipos de datos en los diccionarios
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"] // -> Solo compilar los archivos que están en src/
}
